# Copy to .env and edit. Docker Compose reads this file automatically.

# Public web port (nginx).
WEB_PORT=8080

# GHCR image tag used by `docker compose pull` (latest, sha-xxxx, or a release tag).
IMAGE_TAG=latest

# Leave empty when nginx proxies /api to the backend (recommended).
# Set to an absolute origin when the API is deployed on another host.
VITE_API_BASE_URL=

# Set to your public origin(s), comma separated. Same-origin deployments do
# not need CORS, but this keeps direct API access usable.
CORS_ORIGINS=http://localhost:8080

# CPU inference.
PIXEL_THREADS=4
INFERENCE_CONCURRENCY=1
INFERENCE_WAIT_TIMEOUT=120

# Upload limits.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=30000000

# RMBG-2.0 is gated: accept the model terms on Hugging Face, then provide a
# read token. Set RMBG_ENABLED=false to run pixelization only.
RMBG_ENABLED=true
RMBG_PRELOAD=false
HF_TOKEN=
RMBG_LOCAL_FILES_ONLY=false

# Abuse protection (per client IP, token bucket).
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Build-time switch for the RMBG dependency set.
INSTALL_RMBG=true
